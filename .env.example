# Traugily environment variables — copy to .env if a client-side value is ever needed.
# NOTE: all secrets live in .dev.vars / Cloudflare Worker secrets — never in the
# browser bundle. This file documents naming only.

# Public API base for the client (same-origin by default; set only for split deploys)
VITE_API_BASE_URL=

# Public Stripe publishable key is NOT needed server-side-first Checkout,
# but documented here for future client integrations:
# VITE_STRIPE_PUBLISHABLE_KEY=